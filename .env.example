# Copy to .env.local for local development. Never commit real values.

# Supabase > Project > Connect > "Transaction pooler" connection string (port 6543).
DATABASE_URL=postgres://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# A long random secret. You type it once at /admin/setup to create your admin account.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SETUP_TOKEN=
